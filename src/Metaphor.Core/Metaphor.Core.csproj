<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain logic, testable without the game: no Reloaded-II, nothing Windows-only (ADR 0003). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="known-game-builds.json" LogicalName="Metaphor.Core.known-game-builds.json" />
    <EmbeddedResource Include="hook-signatures.json" LogicalName="Metaphor.Core.hook-signatures.json" />
    <!-- FastLZ's MIT licence, for the decompressor ported in Navigation/FastLz.cs (#179); it ships with the mod. -->
    <None Include="licenses/fastlz/LICENSE.MIT" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
